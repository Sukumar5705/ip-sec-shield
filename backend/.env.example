# IPsec Security Simulator — Environment Configuration
# Copy this file to .env and set values as needed

# Key source: "env" uses AH_SECRET_KEY and ESP_SECRET_KEY from this file.
# "auto" generates keys fresh each time the server starts (default for development).
KEY_SOURCE=auto

# Only used when KEY_SOURCE=env
# Must be a 64-character hex string (32 bytes) for AH HMAC-SHA256 key
AH_SECRET_KEY=

# Must be a 64-character hex string (32 bytes) for ESP AES-256-GCM key
ESP_SECRET_KEY=
